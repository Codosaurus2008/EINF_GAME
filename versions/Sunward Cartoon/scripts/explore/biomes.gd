static func species(id: String) -> Dictionary:
	if SPECIES.has(id):
		return SPECIES[id]
	if ODD.has(id):
		return ODD[id]
	return generated.get(id, SPECIES["gravel_grazer"])


## All species of a planet: [[id, weight], ...] - the hand-made list plus generated ones
static func planet_species(planet_id: String) -> Array:
	var out: Array = get_biome(planet_id)["wildlife"].duplicate()
	out.append_array(ODD_ON.get(planet_id, []))
	for i in GENERATED_PER_PLANET:
		var id := "%s_gen_%d" % [planet_id, i]
		if not generated.has(id):
			generated[id] = Xeno.generate(planet_id, i)
		out.append([id, int(generated[id].get("weight", 2))])
	return out


const GENERATED_PER_PLANET := 13          # alien species made per planet (plus the hand-made ones)


static func get_biome(planet_id: String) -> Dictionary:
	return ALL.get(planet_id, ALL["pebble"])
